{
  "type": "origins:multiple",
  "name": "Hydrophobia",
  "description": "Water burns your lunar-touched skin. You take damage while in water or rain. The Aqua Affinity enchantment on your helmet negates this.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/negative.png",
      "text": "Take damage from water/rain (Aqua Affinity helmet negates)"
    }
  ],
  "water_damage": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "damage @s 1 minecraft:drown"
    },
    "interval": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:fluid_height",
              "fluid": "minecraft:water",
              "comparison": ">",
              "compare_to": 0.0
            },
            {
              "type": "origins:exposed_to_sky",
              "condition": {
                "type": "origins:in_rain"
              }
            }
          ]
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:enchantment",
            "enchantment": "minecraft:aqua_affinity",
            "comparison": ">=",
            "compare_to": 1
          },
          "inverted": true
        }
      ]
    }
  },
  "water_particles": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "particle minecraft:smoke ~ ~1 ~ 0.2 0.3 0.2 0.01 5 normal"
    },
    "interval": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:fluid_height",
              "fluid": "minecraft:water",
              "comparison": ">",
              "compare_to": 0.0
            },
            {
              "type": "origins:exposed_to_sky",
              "condition": {
                "type": "origins:in_rain"
              }
            }
          ]
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:enchantment",
            "enchantment": "minecraft:aqua_affinity",
            "comparison": ">=",
            "compare_to": 1
          },
          "inverted": true
        }
      ]
    }
  }
}
