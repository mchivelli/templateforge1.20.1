{
  "type": "origins:multiple",
  "name": "Moonlit Veil",
  "description": "You become invisible while sneaking at night. Your stealth meter drains while moving invisibly and refills when not sneaking.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": "Sneak at night to become invisible (stealth meter required)"
    }
  ],
  "stealth_meter": {
    "type": "origins:resource",
    "min": 0,
    "max": 400,
    "start_value": 400,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 5,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_stealth_meter",
        "comparison": "<",
        "compare_to": 400
      }
    }
  },
  "drain_meter": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_stealth_meter",
      "change": -4
    },
    "interval": 4,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:invisible"
        },
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:moving"
        }
      ]
    }
  },
  "refill_meter": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_stealth_meter",
      "change": 4
    },
    "interval": 4,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:invisible"
        },
        {
          "type": "origins:sneaking"
        }
      ],
      "inverted": true
    }
  },
  "stealth_cooldown": {
    "type": "origins:resource",
    "min": 0,
    "max": 100,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 1,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_stealth_cooldown",
        "comparison": ">",
        "compare_to": 0
      }
    }
  },
  "tick_cooldown": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_stealth_cooldown",
      "change": -4
    },
    "interval": 4,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_stealth_cooldown",
      "comparison": ">",
      "compare_to": 0
    }
  },
  "invisibility": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:apply_effect",
      "effect": {
        "effect": "minecraft:invisibility",
        "duration": 200,
        "amplifier": 0,
        "is_ambient": true,
        "show_icon": false,
        "show_particles": false
      }
    },
    "rising_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "scale set pehkui:visibility 0 @s"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:entity.player.breath player @s ~ ~ ~ 0.25 1.1"
        }
      ]
    },
    "falling_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:clear_effect",
          "effect": "minecraft:invisibility"
        },
        {
          "type": "origins:execute_command",
          "command": "scale reset pehkui:visibility @s"
        }
      ]
    },
    "interval": 2,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "*:*_stealth_meter",
          "comparison": ">=",
          "compare_to": 1
        },
        {
          "type": "origins:resource",
          "resource": "*:*_stealth_cooldown",
          "comparison": "<",
          "compare_to": 1
        },
        {
          "type": "origins:brightness",
          "comparison": "<=",
          "compare_to": 0.5
        },
        {
          "type": "origins:sneaking"
        }
      ]
    }
  },
  "heartbeat": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "playsound minecraft:entity.warden.heartbeat player @s ~ ~ ~ 0.5 0.6"
    },
    "interval": 32,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:invisible"
        },
        {
          "type": "origins:sneaking"
        }
      ]
    }
  }
}