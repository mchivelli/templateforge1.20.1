{
  "type": "origins:multiple",
  "name": "Flower Affinity",
  "description": "Flowers planted nearby grant you passive bonuses. The flowers must be growing in the ground within 8 blocks.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": "Planted flowers within 8 blocks grant passive effects"
    }
  ],
  "dandelion_effect": {
    "type": "origins:action_over_time",
    "interval": 60,
    "entity_action": {
      "type": "origins:execute_command",
      "command": "effect give @s minecraft:speed 4 0 true"
    },
    "condition": {
      "type": "origins:block_in_radius",
      "block_condition": {
        "type": "origins:block",
        "block": "minecraft:dandelion"
      },
      "radius": 8,
      "shape": "cube",
      "comparison": ">=",
      "compare_to": 1
    }
  },
