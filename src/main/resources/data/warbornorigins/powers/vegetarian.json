{
  "type": "origins:multiple",
  "name": "Vegetarian",
  "description": "Your elven nature rejects the consumption of meat. Eating meat makes you violently ill.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/negative.png",
      "text": "Eating meat causes Nausea, Poison, and Hunger"
    }
  ],
  "meat_sickness": {
    "type": "origins:action_on_item_use",
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "tag": "warbornorigins:meat"
      }
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:nausea 20 1"
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:poison 10 1"
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:hunger 15 2"
        }
      ]
    }
  },
  "meat_tooltip": {
    "type": "origins:tooltip",
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "tag": "warbornorigins:meat"
      }
    },
    "text": [
      {
        "text": "Vegetarian: ",
        "color": "red",
        "bold": true
      },
      {
        "text": "Eating this will make you sick!",
        "color": "dark_red"
      }
    ]
  }
}
