{
  "type": "origins:multiple",
  "name": "Arcane Surge",
  "description": "Consume an Ender Pearl or Blaze Rod to channel arcane energy, granting powerful magical buffs.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": "Hold Ender Pearl: Regeneration II + Resistance I for 15s. Hold Blaze Rod: Strength I + Speed I for 15s. 30s cooldown."
    }
  ],
  "surge_ender": {
    "type": "origins:active_self",
    "cooldown": 600,
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:ingredient",
        "ingredient": {
          "item": "minecraft:ender_pearl"
        }
      }
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "mainhand",
          "action": {
            "type": "origins:consume",
            "amount": 1
          }
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:regeneration 300 1 false"
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:resistance 300 0 false"
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:enchant ~ ~1 ~ 0.5 0.5 0.5 0.1 30 normal"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:entity.enderman.teleport player @a ~ ~ ~ 0.5 1.5"
        }
      ]
    },
    "hud_render": {
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 3
    }
  },
  "surge_blaze": {
    "type": "origins:active_self",
    "cooldown": 600,
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:ingredient",
        "ingredient": {
          "item": "minecraft:blaze_rod"
        }
      }
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "mainhand",
          "action": {
            "type": "origins:consume",
            "amount": 1
          }
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:strength 300 0 false"
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:speed 300 0 false"
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:flame ~ ~1 ~ 0.5 0.5 0.5 0.05 20 normal"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:entity.blaze.shoot player @a ~ ~ ~ 0.5 1.2"
        }
      ]
    },
    "hud_render": {
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 3
    }
  }
}