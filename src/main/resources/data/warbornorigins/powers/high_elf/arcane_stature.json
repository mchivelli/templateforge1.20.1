{
  "type": "origins:multiple",
  "name": "Arcane Stature",
  "description": "High Elves are tall and slender, carrying themselves with regal poise.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "Tall and slim build (2.0 blocks height, 0.9x width via Pehkui)"
    }
  ],
  "stature_on": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:high_elf_height_on"
    },
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:high_elf_height_off"
    },
    "execute_chosen_when_orb": true
  },
  "stature_persist": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:high_elf_height_on"
    },
    "interval": 200
  },
  "stature_respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:high_elf_height_on"
    }
  }
}