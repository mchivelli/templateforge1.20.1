{
  "type": "origins:action_on_callback",
  "name": "Elven Stature",
  "description": "Wood Elves are taller than humans, standing at a graceful 2 blocks in height.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "Tall and slender (2.0 blocks height via Pehkui)"
    }
  ],
  "entity_action_gained": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:height 1.111 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:model_height 1.111 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:height true @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:model_height true @s"
      }
    ]
  },
  "entity_action_lost": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:height false @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:model_height false @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:height 1.0 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:model_height 1.0 @s"
      }
    ]
  },
  "entity_action_added": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:height 1.111 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:model_height 1.111 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:height true @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:model_height true @s"
      }
    ]
  },
  "entity_action_removed": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:height false @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale persist set pehkui:model_height false @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:height 1.0 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:model_height 1.0 @s"
      }
    ]
  },
  "entity_action_respawned": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:height 1.111 @s"
      },
      {
        "type": "origins:execute_command",
        "command": "scale set pehkui:model_height 1.111 @s"
      }
    ]
  }
}