{
  "type": "origins:multiple",
  "name": "Lucky Fingers",
  "description": "Goblins have an uncanny knack for finding treasure. You have permanent Luck and find better loot.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": "Ability: Permanent Luck I, activatable Luck III burst (30s cooldown)"
    }
  ],
  "passive_luck": {
    "type": "origins:attribute",
    "modifier": {
      "attribute": "minecraft:generic.luck",
      "value": 1.0,
      "operation": "addition"
    }
  },
  "luck_burst": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "effect give @s minecraft:luck 15 2"
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:happy_villager ~ ~1 ~ 0.4 0.4 0.4 0.1 15 normal"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 1.0 1.5"
        }
      ]
    },
    "cooldown": 600,
    "hud_render": {
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 3
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  }
}
