{
  "type": "origins:multiple",
  "name": "Siren's Song",
  "description": "Sing an enchanting melody that pacifies all hostile mobs nearby, making them temporarily unable to attack.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": "Ability: Pacify hostile mobs within 10 blocks for 8s (Slowness V + Weakness III). 30s cooldown."
    }
  ],
  "song_cooldown": {
    "type": "origins:resource",
    "min": 0,
    "max": 600,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 8,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_song_cooldown",
        "comparison": ">",
        "compare_to": 0
      }
    }
  },
  "cooldown_tick": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_song_cooldown",
      "change": -4
    },
    "interval": 4,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_song_cooldown",
      "comparison": ">",
      "compare_to": 0
    }
  },
  "sing": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:area_of_effect",
          "radius": 10.0,
          "shape": "sphere",
          "bientity_action": {
            "type": "origins:target_action",
            "action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:apply_effect",
                  "effect": {
                    "effect": "minecraft:slowness",
                    "duration": 160,
                    "amplifier": 4,
                    "is_ambient": false,
                    "show_particles": true
                  }
                },
                {
                  "type": "origins:apply_effect",
                  "effect": {
                    "effect": "minecraft:weakness",
                    "duration": 160,
                    "amplifier": 2,
                    "is_ambient": false,
                    "show_particles": true
                  }
                }
              ]
            }
          },
          "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:and",
              "conditions": [
                {
                  "type": "origins:living"
                },
                {
                  "type": "origins:entity_type",
                  "entity_type": "minecraft:player",
                  "inverted": true
                }
              ]
            }
          }
        },
        {
          "type": "origins:change_resource",
          "resource": "warbornorigins:siren/sirens_song_song_cooldown",
          "change": 600
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:note ~ ~2 ~ 1 0.5 1 0.5 15 normal"
        },
        {
          "type": "origins:execute_command",
          "command": "particle minecraft:enchant ~ ~1 ~ 2 1 2 1 30 normal"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:block.amethyst_block.chime player @a ~ ~ ~ 1.5 0.8"
        },
        {
          "type": "origins:execute_command",
          "command": "playsound minecraft:block.amethyst_cluster.break player @a ~ ~ ~ 1.0 1.2"
        }
      ]
    },
    "cooldown": 1,
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "condition": {
      "type": "origins:resource",
      "resource": "warbornorigins:siren/sirens_song_song_cooldown",
      "comparison": "<=",
      "compare_to": 0
    }
  }
}
