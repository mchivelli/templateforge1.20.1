{
  "type": "origins:multiple",
  "name": "Orc Stature",
  "description": "Orcs are tall and broad, towering over most other races.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "Broad and imposing (1.9 blocks tall, 1.2x width via Pehkui)"
    }
  ],
  "stature_on": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:orc_height_on"
    },
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:orc_height_off"
    },
    "execute_chosen_when_orb": true
  },
  "stature_persist": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:orc_height_on"
    },
    "interval": 200
  },
  "stature_respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:orc_height_on"
    }
  }
}