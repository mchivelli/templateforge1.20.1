{
  "type": "origins:multiple",
  "name": "Dashing Supremacy",
  "description": "While sprinting, your massive body crashes into anything nearby, knocking all colliding entities away with brutal force.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/positive.png",
      "text": "Knocks nearby entities away while sprinting (every 0.5s)"
    }
  ],
  "sprint_collision": {
    "type": "origins:action_over_time",
    "interval": 10,
    "entity_action": {
      "type": "origins:area_of_effect",
      "radius": 1.5,
      "shape": "sphere",
      "bientity_action": {
        "type": "origins:target_action",
        "action": {
          "type": "origins:add_velocity",
          "space": "velocity_horizontal_normalized",
          "z": 1.2,
          "y": 0.3
        }
      },
      "bientity_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:living"
            }
          },
          {
            "type": "origins:actor_condition",
            "condition": {
              "type": "origins:sprinting"
            }
          }
        ]
      }
    }
  }
}