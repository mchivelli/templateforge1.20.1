{
  "type": "origins:multiple",
  "name": "Mountain Stature",
  "description": "Mountain Dwarves are short and broad, built like the stone they mine.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "Short and broad (0.8x height, 1.1x width via Pehkui)"
    }
  ],
  "stature_on": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:mountain_dwarf_height_on"
    },
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:mountain_dwarf_height_off"
    },
    "execute_chosen_when_orb": true
  },
  "stature_persist": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:mountain_dwarf_height_on"
    },
    "interval": 200
  },
  "stature_respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:mountain_dwarf_height_on"
    }
  }
}
