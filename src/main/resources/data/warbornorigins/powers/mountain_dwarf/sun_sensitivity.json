{
  "type": "origins:multiple",
  "name": "Sun Sensitivity",
  "description": "A lifetime underground has made your eyes and skin sensitive to sunlight. Wearing a helmet protects you.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/negative.png",
      "text": "Take 1 damage every 2s in direct sunlight unless wearing a helmet"
    }
  ],
  "sun_damage": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "damage @s 1 minecraft:on_fire"
    },
    "interval": 40,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:exposed_to_sun"
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:empty"
          }
        }
      ]
    }
  },
  "sun_particles": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "particle minecraft:smoke ~ ~1.5 ~ 0.2 0.2 0.2 0.01 3 normal"
    },
    "interval": 40,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:exposed_to_sun"
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:empty"
          }
        }
      ]
    }
  }
}
