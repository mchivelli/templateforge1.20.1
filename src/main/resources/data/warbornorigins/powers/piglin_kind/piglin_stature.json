{
  "type": "origins:multiple",
  "name": "Piglin Stature",
  "description": "Piglin Kind are slightly larger and broader than humans.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": "Slightly larger build (1.05x height, 1.05x width via Pehkui)"
    }
  ],
  "stature_on": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:piglin_kind_height_on"
    },
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:piglin_kind_height_off"
    },
    "execute_chosen_when_orb": true
  },
  "stature_persist": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:piglin_kind_height_on"
    },
    "interval": 200
  },
  "stature_respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:execute_command",
      "command": "function warbornorigins:piglin_kind_height_on"
    }
  }
}
