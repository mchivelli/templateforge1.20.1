{
  "type": "origins:multiple",
  "name": "Hydrophobia",
  "description": "Water burns your Nether-forged skin. Aqua Affinity enchantment on your helmet protects you.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/negative.png",
      "text": "1 damage every 1.5s in water or rain (Aqua Affinity helmet negates)"
    }
  ],
  "water_damage": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "damage @s 1 minecraft:drown"
    },
    "interval": 30,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:or",
          "conditions": [
            { "type": "origins:submerged_in", "fluid": "minecraft:water" },
            { "type": "origins:in_rain" }
          ]
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:enchantment",
            "enchantment": "minecraft:aqua_affinity",
            "comparison": ">=",
            "compare_to": 1
          },
          "inverted": true
        }
      ]
    }
  },
  "water_particles": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "particle minecraft:smoke ~ ~1 ~ 0.2 0.3 0.2 0.01 5 normal"
    },
    "interval": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:or",
          "conditions": [
            { "type": "origins:submerged_in", "fluid": "minecraft:water" },
            { "type": "origins:in_rain" }
          ]
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:enchantment",
            "enchantment": "minecraft:aqua_affinity",
            "comparison": ">=",
            "compare_to": 1
          },
          "inverted": true
        }
      ]
    }
  }
}
