{
  "type": "origins:multiple",
  "name": "Black Thumb",
  "description": "Life withers at your touch. You cannot harvest crops.",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/negative.png",
      "text": "Cannot harvest crops"
    }
  ],
  "prevent_harvest": {
    "type": "origins:modify_harvest",
    "block_condition": {
      "type": "origins:in_tag",
      "tag": "warbornorigins:crops"
    },
    "allow": false
  },
  "hint_break": {
    "type": "origins:action_on_block_break",
    "block_condition": {
      "type": "origins:in_tag",
      "tag": "warbornorigins:crops"
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "title @s actionbar {\"translate\":\"text.warbornorigins.revenant.black_thumb\",\"color\":\"red\"}"
    }
  },
  "hint_use": {
    "type": "origins:action_on_block_use",
    "block_condition": {
      "type": "origins:in_tag",
      "tag": "warbornorigins:crops"
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "title @s actionbar {\"translate\":\"text.warbornorigins.revenant.black_thumb\",\"color\":\"red\"}"
    }
  }
}
